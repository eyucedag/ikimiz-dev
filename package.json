  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --tunnel ngrok --clear",
    "start:go:lan": "expo start --go --lan --clear",
    "update:preview": "node --env-file-if-exists=.env --require ./scripts/eas-gcs-path.cjs ./node_modules/eas-cli/bin/run update --channel shared-preview --environment preview --platform all --non-interactive",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __tests__/*.test.ts",
    "lint": "eslint .",
    "export": "expo export --platform web",
    "test:db": "node supabase/tests/run.mjs",
    "test:ui": "playwright test"
  },
  "private": true
