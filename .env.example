# Supabase project settings > API. These values are public client configuration.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional: use the exact URL printed by `npm run start:go` while Expo Go is running.
# Otherwise the app derives the current Expo Go URL automatically.
# EXPO_PUBLIC_AUTH_REDIRECT_URL=exp://YOUR_TUNNEL/--/auth

# Never put service_role, database passwords, or sb_secret_* keys in this file.
# Without these values the app runs in its explicitly labelled local trial area.
